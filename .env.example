# Copie para .env e ajuste os valores.
# Nao versionar o .env (ja esta no .gitignore).

# Aplicacao
PORT=3000
HOST=127.0.0.1

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lab_user
DB_PASSWORD=lab_password
DB_NAME=lab_palestra
DB_ROOT_PASSWORD=lab_root_password

# --- Implantacao na EC2 (13 bancadas) ---------------------------------------
# Estas tres variaveis nao sao usadas pelo `docker compose up` de
# desenvolvimento. Elas entram em cena em
# `docker/compose/docker-compose.student.yml`, e o `scripts/iniciar_labs.sh` as
# exporta sozinho -- este bloco serve para quem sobe UMA bancada a mao.
#
# APP_PORT e a porta publicada no host. Primeira bancada 3001, ultima 3013.
APP_PORT=3001

# Identidade da bancada. Aparece no cookie sintetico `lab_session` e nos logs.
# E um rotulo de laboratorio: nao concede acesso a nada.
LAB_ALUNO_ID=aluno01

# `Secure` no cookie de sessao so faz sentido sob HTTPS. A implantacao por
# portas roda em HTTP, entao o padrao e false. Valores aceitos: false/0 (padrao)
# e true/1. Vale para os dois cookies, `lab_mode` e `lab_session`.
LAB_SECURE_COOKIES=false
